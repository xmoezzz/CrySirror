  "adoption": "Compiled native VM/syscall/resource/save policy adopted as first-class CrySirror source. Origin hashes document the pinned baseline; patched hashes identify local maintenance. The former upstream runtime directory, software rasterizer/mixer, private pixel storage, font raster and text bank implementations are not retained as a second engine.",
  "removed_sources": {
    "src/host_api/soft_raster.rs": "aa68a031b7b4dba950292b6cb1039894c065a25c05f02e67f919962236d03b41",
    "src/host_api/srgb_tables.rs": "6079b94fd7aed6a34bae073734c7ae2dc6460d49420db2f38c9d00706dc3a8fa"
  },
  "ownership": "HCB globals belong to GameData and are passed explicitly to opcodes through VmSyscall. No process-wide GLOBAL or unsafe singleton remains. Existing original save envelopes keep their field order and select the same regions from the owning VM. Character tables, history/config staging and exit requests are also per GameData. Immutable syscall registrations and diagnostic counters remain process services; full scheduling/ownership audit is not claimed complete.",
  "engine_capabilities": [
    "crysirror-image::nvsg / pixels / bitmap::blit_rgba8 / associated tone and coverage operations",
    "crysirror-image::buffer backing types; no private unsafe pixel storage",
    "crysirror-text::bitmap_font / slot_color / vn_slot",
    "CrySirror channel audio, mix groups, source EOF observations, surfaces and PuppetFrame rendering",
    "crysirror-puppet::cpu_snapshot immutable engine mesh captures; original rasterizer not reused"
  ],
  "remaining_limits": [
    "Native engine task scheduling, async image/font/scenario admission and audio preparation waits are not complete.",
    "Native video/PCM streaming, full font-face selection, framework snapshots and complete game/save coverage are unproven or unsupported.",
    "Legacy slot-picker/title-cache/menu-shell and exit-dialog UI require engine mappings and now fail explicitly. Native local saves are not claimed fully validated.",
    "Frame snapshots use shared engine CPU MeshSnapshot; GPU-reference parity and a live async completion boundary remain unproven."
  ]
}

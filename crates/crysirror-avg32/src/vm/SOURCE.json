 "license": "MPL-2.0",
 "excluded_upstream_modules": {
  "engine.rs": "replaced by vm/engine.rs (same tick/input/save-action logic; opens through vm::fs on the engine clock)",
  "font.rs": "TrueType rasteriser removed; only the game's FN.DAT bitmap font remains (vm/font.rs)",
  "movie.rs": "Cinepak decoding removed; vm/movie.rs reports the missing shared video decoder",
  "pdt.rs": "shared crysirror_image::pdt",
  "lib.rs": "crate root replaced by the CrySirror adapter",
  "bin/": "desktop player/probe not vendored"
 },
 "new_seams": {
  "vm/fs.rs": "game_fs replacement over client capability storage; @save/ is the client save mount; asset writes rejected",
  "vm/text.rs": "retained glyph layer replacing rasterisation into buffer 0; glyphs drop under buffer-0 write damage",
  "vm/movie.rs": "visible failure stand-in"
 },
 "seam_changes": [
  "every crate:: path became crate::vm::; buffer/pdtmgr/effect/pdt became crysirror_image::{avg32::{buffer,bank,effect},pdt}",
  "game.rs: engine_detect replaced by a Gameexe.ini lookup (the project names the adapter)",
  "game_fs::{read,read_dir,write,open,is_dir,is_file,read_to_string,file_len} -> vm::fs equivalents",
  "sound.rs: kira device replaced by AudioCommand queue on engine channels; playing = engine channel state",
  "system.rs: Clock is the engine clock only; AVG32_VERSION/AVG32_SAVE_DIR env reads removed; SAVE.INI on @save; frame_rgba replaced by screen_rgba/shake_offset/overlay",
  "meswin.rs: draw_char keeps buffer-0 glyphs in vm::text (other buffers warn); window frame/icon writes report damage",
  "menu.rs: fill/text record an Overlay (rects + glyphs) instead of drawing into RGBA",
  "system.rs: screen_fade reports full-screen damage",
  "tests that used the host filesystem (savedata, sound CloneCD) are not vendored",
  "meswin.rs: choice-row inversion recolours the glyphs in that row (vm::text::invert) instead of removing them",
  "vm/fs.rs: the game root may be the asset root (empty root)",
  "CUR16M pixels/mask/colour-key decoding moved to crysirror-image::cursor; native CUR loading retains only format/resource policy and the shared UI presents animated/standard pointer selection."
 ],
 "shared_device_changes": [
  "bank.rs: buffer-0 write damage (mark_damage/take_damage), present revision counter",
  "effect.rs: buffer-0 damage before present; three unneeded `mut` bindings removed"
 ],

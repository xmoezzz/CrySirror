{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CrySirror synthetic host-service project v1",
  "description": "Not an RFVP HCB or Siglus SS file. Path traversal and byte-length checks are additionally enforced by the validator.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "console_targets": {
      "type": "array",
      "items": {
        "enum": [
          "switch",
          "psv"
        ]
      },
      "uniqueItems": true,
      "minItems": 2,
      "maxItems": 2
    },
    "clients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "engine": {
            "enum": [
              "rfvp",
              "siglus"
            ]
          },
          "game": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "layout_profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "commands": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "const": "text.put"
                    },
                    "id": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "x": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "y": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    },
                    "z": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "rgba": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 1048576
                    },
                    "font": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "size_px": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  },
                  "required": [
                    "op",
                    "id",
                    "x",
                    "y",
                    "width",
                    "height",
                    "z",
                    "rgba",
                    "text",
                    "font",
                    "size_px"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "const": "sprite.put"
                    },
                    "id": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "x": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "y": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    },
                    "z": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "rgba": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "asset": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "op",
                    "id",
                    "x",
                    "y",
                    "width",
                    "height",
                    "z",
                    "rgba",
                    "asset"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "const": "visual.remove"
                    },
                    "id": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  },
                  "required": [
                    "op",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "const": "audio.play"
                    },
                    "channel": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    },
                    "asset": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "looping": {
                      "type": "boolean"
                    },
                    "gain_milli": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "op",
                    "channel",
                    "asset",
                    "looping",
                    "gain_milli"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "const": "audio.stop"
                    },
                    "channel": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295
                    }
                  },
                  "required": [
                    "op",
                    "channel"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "name",
          "engine",
          "game",
          "layout_profile",
          "commands"
        ],
        "additionalProperties": false
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "visuals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "voices": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        }
      },
      "required": [
        "visuals",
        "voices"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "name",
    "console_targets",
    "clients",
    "expected"
  ],
  "additionalProperties": false
}
